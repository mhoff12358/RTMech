; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

_global_script_classes=[{
"base": "Node2D",
"class": &"Footsteps",
"language": &"GDScript",
"path": "res://Player/Footsteps.gd"
}, {
"base": "Node",
"class": &"MissileController",
"language": &"GDScript",
"path": "res://Player/MissileController.gd"
}, {
"base": "Node",
"class": &"PlayerController",
"language": &"GDScript",
"path": "res://Player/PlayerController.gd"
}, {
"base": "Polygon2D",
"class": &"ShapePolygon2D",
"language": &"GDScript",
"path": "res://ShapePolygon2D.gd"
}, {
"base": "DIContext",
"class": &"Throttle",
"language": &"GDScript",
"path": "res://UI/Throttle.gd"
}, {
"base": "Node",
"class": &"WalkingState",
"language": &"GDScript",
"path": "res://Player/WalkingState.gd"
}]
_global_script_class_icons={
"Footsteps": "",
"MissileController": "",
"PlayerController": "",
"ShapePolygon2D": "",
"Throttle": "",
"WalkingState": ""
}

[application]

config/name="RTMech"
run/main_scene="res://test_scene.tscn"
config/features=PackedStringArray("4.0", "Mobile")
config/icon="res://icon.svg"

[editor_plugins]

enabled=PackedStringArray("res://addons/script_caller/plugin.cfg")

